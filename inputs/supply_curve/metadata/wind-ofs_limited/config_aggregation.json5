{
    "cf_dset": "cf_mean-means",
    "data_layers": {
        "regulation_osw_wind_lease_areas_boem": {
            "dset": "regulation_osw_wind_lease_areas_boem",
            "method": "sum"
        },
        "regulation_distance_to_coast_limited": {
            "dset": "regulation_distance_to_coast_limited",
            "method": "mean"
        }
    },
    "log_directory": "./logs",
    "excl_dict": {
        "regulation_bathymetry": {
            "exclude_range": [
                -20000,
                -1000
            ]
        },
        "infrastructure_osw_gas_pipelines_limited_122m_buffer": {
            "exclude_values": [
                1
            ]
        },

        //should be 122m--double check
        "infrastructure_osw_oil_pipelines_reference_61m_buffer": {
            "exclude_values": [
                1
            ]
        },
        "infrastructure_osw_shipping_lanes": {
            "exclude_values": [
                1,
                2,
                3
            ]
        },
        "environment_marine_conservation_areas": {
            "exclude_values": [
                1,
                2,
                3,
                4,
                5,
                6
            ]
        },
        "defense_danger_zones_and_restricted_areas": {
            "exclude_values": [
                1
            ]
        },
        "regulation_distance_to_coast_limited": {
            "include_range": [
                30000,
                99999999
            ]
        },
        "defense_department_of_defense_designations": {
            "exclude_values": [
                3
            ]
        },
        "regulation_development_production_plans_option_areas": {
            "exclude_values": [
                1
            ]
        },
        "regulation_gas_wells_limited_500m_buffer": {
            "exclude_values": [
                1
            ]
        },
         "infrastructure_oil_gas_planning_areas_boem": {
            "force_include_values": [
                1
            ]
        },
        "regulation_great_lake_shipwrecks_limited_100m_buffer": {
            "exclude_values": [
                1
            ]
        },
        "environment_great_lakes_marine_protected_areas": {
            "exclude_values": [
                1
            ]
        },
        "defense_great_lakes_restricted_areas": {
            "exclude_values": [
                1
            ]
        },
        "defense_ship_shock_boxes": {
            "exclude_values": [
                1
            ]
        },
        "defense_submarine_transit_lanes": {
            "exclude_values": [
                1
            ]
        },
        "infrastructure_osw_noaa_charted_submarine_cables_limited_1000m_buffer": {
            "exclude_values": [
                1
            ]
        },
        "regulation_ocean_disposal_sites": {
            "exclude_values": [
                1,
                2,
                3,
                4
            ]
        },
        "environment_ocs_sand_gravel_borrow_areas": {
            "exclude_values": [
                1
            ]
        },
        "infrastructure_osw_oil_platforms_limited_500m_buffer": {
            "exclude_values": [
                1
            ]
        },
        "defense_unexploded_ordnance_areas": {
            "exclude_values": [
                1
            ]
        },
        "defense_unexploded_ordnance_locations_limited_200m_buffer": {
            "exclude_values": [
                1
            ]
        },
        "regulation_osw_wind_lease_areas_boem": {
            "force_include_values": [
                1
            ]
        },
        "defense_dod_oregon_coast": {
            "exclude_values": [
                1
            ]
        },
        "environment_canyons": {
            "exclude_values": [
                1
            ]
        },
        "regulation_anchorage_west_coast_uscg": {
            "exclude_values": [
                1
            ]
        },
        "regulation_fairways_pacific_coast_port_access_cg": {
            "exclude_values": [
                1
            ]
        },
        "environment_usual_accustomed_areas_washington": {
            "exclude_values": [
                1
            ]
        },
        "regulation_crabber_tug_lanes_west_coast": {
            "exclude_values": [
                1
            ]
        },
        "environment_official_chumash_nms": {
            "exclude_values": [
                1
            ]
        },
        "environment_artificial_reefs": {
            "exclude_values": [
                1
            ]
        },
        "regulation_state_waters": {
            "exclude_values": [
                1
            ]
        }
    },
    "excl_fpath": "/projects/rev/data/exclusions/north_america/conus/standard_exclusions_and_characterizations_fy25.h5",
    "execution_control": {
        "allocation": "wetosa",
        "memory": 240,
        "nodes": 1,
        "option": "kestrel",
        "walltime": 1
    },
    "gen_fpath": "/projects/rev/projects/weto/fy25/standard_scenarios/osw/rev/generation/generation_multi_year.h5",
    "lcoe_dset": "lcoe_fcr-means",
    "power_density": 4,
    "res_class_dset": "ws_mean-means",
    "res_fpath": [
         "/datasets/WIND/conus/v1.0.0/wtk_conus_2007.h5",
        "/datasets/WIND/conus/v1.0.0/wtk_conus_2008.h5",
        "/datasets/WIND/conus/v1.0.0/wtk_conus_2009.h5",
        "/datasets/WIND/conus/v1.0.0/wtk_conus_2010.h5",
        "/datasets/WIND/conus/v1.0.0/wtk_conus_2011.h5",
        "/datasets/WIND/conus/v1.0.0/wtk_conus_2012.h5",
        "/datasets/WIND/conus/v1.0.0/wtk_conus_2013.h5",
        "/datasets/WIND/HRRR/bchrrr_conus_2015.h5",
        "/datasets/WIND/HRRR/bchrrr_conus_2016.h5",
        "/datasets/WIND/HRRR/bchrrr_conus_2017.h5",
        "/datasets/WIND/HRRR/bchrrr_conus_2018.h5",
        "/datasets/WIND/HRRR/bchrrr_conus_2019.h5",
        "/datasets/WIND/HRRR/bchrrr_conus_2020.h5",
        "/datasets/WIND/HRRR/bchrrr_conus_2021.h5",
        "/datasets/WIND/HRRR/bchrrr_conus_2022.h5",
        "/datasets/WIND/HRRR/bchrrr_conus_2023.h5"
    ],
    "resolution": 128,
    "tm_dset": "techmap_wtk_bchrrr_fy26",
    "pre_extract_inclusions": true,
    "cap_cost_scale": "np.interp(capacity_ac_mw, [100, 250, 500, 600, 1000, 1500, 2000, 2500], [1.62219836, 1.09418827, 1.050322942, 1.0, 0.953983702, 0.959910612, 0.946231575, 0.955858493])",
    "h5_dsets": [
        "depth",
        "dist_p_to_s",
        "substructure",
        "capital_cost",
        "fixed_operating_cost",
        "variable_operating_cost",
